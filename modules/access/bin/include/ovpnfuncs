get_gray_ip()
{
ip route get 1.1.1.1 | grep src | awk '{print $7}'
}

easyrsainstall()
{
cd /var/cld/tmp/
wget -O /tmp/easyrsa https://github.com/OpenVPN/easy-rsa/releases/download/v3.2.0/EasyRSA-3.2.0.tgz
tar xfz /tmp/easyrsa
mkdir /etc/openvpn/easy-rsa
/usr/bin/cp -rf EasyRSA-3.2.0/* /etc/openvpn/easy-rsa
}

openvpninstall()
{
dnf install -y https://dl.fedoraproject.org/pub/epel/epel-release-latest-9.noarch.rpm
dnf install -y openvpn wget expect opensc openssl-pkcs11
easyrsainstall
}

package-install()
{
if grep -qi centos /etc/*-release
then
yum install $1 -y
elif grep -qi debian /etc/*-release
then
apt install $1 -y
fi
}

checkvpnmode()
{
if [ "${VPN_MODE}" != "AUTH"  -a "${NETWORK_POLICY}" = "general" ]; then
cat << 'EOVPNMODE' || echo -n ''
push "redirect-gateway def1 bypass-dhcp"
push "dhcp-option DNS 1.1.1.1"
push "dhcp-option DNS 1.0.0.1"
EOVPNMODE
fi
}

ip2dec()
{
IP=$1;IPDEC=0
for NUM in 3 2 1 0
do
((IPDEC+=${IP%%.*}*$((256**${NUM})))) ; IP=${IP#*.}
done
echo $IPDEC
}

dec2ip()
{
echo $(($(($(($((${1}/256))/256))/256))%256)).$(($(($((${1}/256))/256))%256)).$(($((${1}/256))%256)).$((${1}%256))
}

ovpngenerate()
{

{
unalias cp &>/dev/null

which openvpn || openvpninstall
which expect || dnf install expect
which ntpdate || dnf install ntpdate
[ -f "/etc/openvpn/easy-rsa/easyrsa" ] || easyrsainstall

for i in ${@:1}
do
  case $i in
    -p=*|-port=*|--port=*) PORT="${i#*=}"           ;;
    -n=*|-network=*|--network=*) NETWORK="${i#*=}"  ;;
    -i=*|-ip=*|--ip=*) VPN_IP="${i#*=}"             ;;
    -I=*|-id=*|--id=*) VPN_ID="${i#*=}"             ;;
    -m=*|-mode=*|--mode=*) VPN_MODE="${i#*=}"       ;;
    -*)                                             ;;
    *) let ii++; declare ARG$ii=${i}                ;;
  esac
done

echo ${@:1} | grep -q '\-\-port=' || PORT=""
echo ${@:1} | grep -q '\-\-network=' || NETWORK=""
echo ${@:1} | grep -q '\-\-ip=' || VPN_IP=""
echo ${@:1} | grep -q '\-\-id=' || VPN_ID=""

if [ "$VPN_ID" = "" ] ; then exit 1 ; fi ; echo $VPN_ID
if [ "$PORT" = "" ] ; then PORT=$(grep port /etc/openvpn/server/server*.conf | cut -d ' ' -f 2 | sort -n | tail -1) ; let "PORT++" ; fi ; echo $PORT
if [ "$PORT" = "1" ] ; then PORT=1194 ; fi ; echo $PORT

if ! [ "$NETWORK" ] ; then
NETWORK=$(grep server /etc/openvpn/server/server*.conf -h | grep "^server 10" | awk '{print $2}' |  sort -t . -k 1,1n -k 2,2n -k 3,3n -k 4,4n | tail -1)
    if ! [ "$NETWORK" ] ; then
        NETWORK=${NETWORK:-10.8.0.0}
    else
        let NETDEC=$(ip2dec $NETWORK)+16
        NETWORK=$(dec2ip $NETDEC)
    fi
fi
echo $NETWORK
VPN_IP=$(wget -qO- ip.cldcloud.com)
export VPN_IP
export VPN_ID
export PORT
export NETWORK
export NETIP=$VPN_IP
ip addr show | grep -q ${VPN_IP} || export NETIP=$(get_gray_ip)
timedatectl set-local-rtc 1
chronyc -a makestep

cat > /etc/openvpn/server/server_${VPN_ID}.conf << EOALL
port ${PORT}
proto udp
dev tun
ca ca_${VPN_ID}.crt
cert server_${VPN_ID}.crt
key server_${VPN_ID}.key  # This file should be kept secret
dh dh.pem
server ${NETWORK} 255.255.255.240
ifconfig-pool-persist ipp.txt
$(checkvpnmode)
;client-to-client
duplicate-cn
keepalive 10 120
;tls-auth ta_${VPN_ID}.key 0 # This file is secret
tls-crypt-v2 tcv2_${VPN_ID}.key
key-direction 0
cipher AES-256-GCM   # AES
# auth SHA256
# comp-lzo
user nobody
group nobody
ncp-disable
persist-key
persist-tun
status openvpn-status.log
verb 3
script-security 3
# client-connect "/usr/bin/sudo /etc/openvpn/ovpnipinit ${VPN_ID}"
EOALL

openvpn --genkey --secret /etc/openvpn/server/myvpn.tlsauth_${VPN_ID}

rm -f /etc/openvpn/easy-rsa/keys/*
cd /etc/openvpn/easy-rsa

# # Generate a static OpenVPN key
# openvpn --genkey secret /etc/openvpn/myvpn.tlsauth_${VPN_ID}
openvpn --genkey tls-crypt-v2-server /etc/openvpn/server/myvpn.tlscryptv2_server_${VPN_ID}
openvpn --genkey tls-crypt-v2-client --tls-crypt-v2 /etc/openvpn/server/myvpn.tlscryptv2_server_${VPN_ID} > /etc/openvpn/server/myvpn.tlscryptv2_client_${VPN_ID}


# Set up Easy-RSA 3 environment
export EASYRSA_DIR="/etc/openvpn/easy-rsa"
mkdir -p ${EASYRSA_DIR}
cd ${EASYRSA_DIR}

# Initialize Easy-RSA 3 directory and configuration
./easyrsa --batch init-pki

# Copy default vars file and modify it if needed
/usr/bin/cp -f /etc/openvpn/easy-rsa/vars.example /etc/openvpn/easy-rsa/vars

cat >> vars << EOVARS
set_var EASYRSA_DIR "/etc/openvpn/easy-rsa"
set_var EASYRSA_REQ_COUNTRY    "US"
set_var EASYRSA_REQ_PROVINCE   "NY"
set_var EASYRSA_REQ_CITY       "New York"
set_var EASYRSA_REQ_ORG        "Example"
set_var EASYRSA_REQ_EMAIL      "my@example.com"
set_var EASYRSA_REQ_OU         "Community"
set_var EASYRSA_CA_EXPIRE      3650
set_var EASYRSA_CERT_EXPIRE    3650
set_var EASYRSA_CRL_DAYS       3650
EOVARS


# Clean up any previous keys
./easyrsa --batch clean-all

./easyrsa --batch init-pki

# Build CA and server certificate
./easyrsa --batch build-ca nopass
# /etc/openvpn/easy-rsa/pki/ca.crt

./easyrsa --batch gen-req server nopass
# /etc/openvpn/easy-rsa/pki/reqs/server.req
# /etc/openvpn/easy-rsa/pki/private/server.key

./easyrsa --batch sign-req server server
# /etc/openvpn/easy-rsa/pki/issued/server.crt

# Generate Diffie-Hellman parameters
[ -f "/etc/openvpn/server/dh.pem" ] || ./easyrsa gen-dh

# Generate client certificate
./easyrsa --batch gen-req id_${VPN_ID} nopass
# /etc/openvpn/easy-rsa/pki/reqs/id_99541.req
# /etc/openvpn/easy-rsa/pki/private/id_99541.key

./easyrsa --batch sign-req client id_${VPN_ID}
# /etc/openvpn/easy-rsa/pki/issued/id_99541.crt

mkdir -p /etc/openvpn/easy-rsa/keys/ &>/dev/null

# Copy certificates and keys to OpenVPN directory
[ -f "/etc/openvpn/server/dh.pem" ] || cp pki/dh.pem /etc/openvpn/server/dh.pem

unalias cp

/usr/bin/cp -f pki/ca.crt /etc/openvpn/server/ca_${VPN_ID}.crt
/usr/bin/cp -f pki/issued/server.crt /etc/openvpn/server/server_${VPN_ID}.crt
/usr/bin/cp -f pki/private/server.key /etc/openvpn/server/server_${VPN_ID}.key
/usr/bin/cp -f pki/issued/id_${VPN_ID}.crt /etc/openvpn/server/id_${VPN_ID}.crt
/usr/bin/cp -f pki/private/id_${VPN_ID}.key /etc/openvpn/server/id_${VPN_ID}.key

/usr/bin/cp -f pki/private/id_${VPN_ID}.key /etc/openvpn/easy-rsa/keys/
/usr/bin/cp -f pki/issued/id_${VPN_ID}.crt /etc/openvpn/easy-rsa/keys/
/usr/bin/cp -f pki/ca.crt /etc/openvpn/easy-rsa/keys/

# /usr/bin/cp -f /etc/openvpn/easy-rsa/openssl-1.0.0.cnf /etc/openvpn/easy-rsa/openssl.cnf
# /usr/bin/cp -f /etc/openvpn/server/myvpn.tlsauth_${VPN_ID} /etc/openvpn/server/ta_${VPN_ID}.key
/usr/bin/cp -f /etc/openvpn/server/myvpn.tlscryptv2_server_${VPN_ID} /etc/openvpn/server/tcv2_${VPN_ID}.key
# /usr/bin/cp -f /etc/openvpn/server/myvpn.tlsauth_${VPN_ID} /etc/openvpn/easy-rsa/keys/ta_${VPN_ID}.key
/usr/bin/cp -f /etc/openvpn/server/myvpn.tlscryptv2_client_${VPN_ID} /etc/openvpn/easy-rsa/keys/tcv2_${VPN_ID}.key
rm -f /etc/openvpn/myvpn.tlsauth_${VPN_ID}

export SERVERIP=$(wget -qO- ip.cldcloud.com)

if [ "${VPN_MODE}" != "AUTH"  -a "${NETWORK_POLICY}" = "general" ]; then
cat > /etc/openvpn/server/iptables_${VPN_ID}.rules << EOTABLES
    iptables -A FORWARD -s ${NETWORK}/28 -j ACCEPT -m comment --comment cldovpn
    iptables -t nat -A POSTROUTING -s ${NETWORK}/28 -j SNAT --to ${NETIP} -m comment --comment cldovpn
EOTABLES
else
    touch /etc/openvpn/server/iptables_${VPN_ID}.rules
fi

mkdir /root/sbin
cat > /root/sbin/cld_ovpn_iptables << 'EOIPTABLES'
#!/bin/bash
iptables-save | grep -v "cldovpn" | iptables-restore ; source <(cat /etc/openvpn/iptables_*.rules)
EOIPTABLES

chmod 700 /root/sbin/cld_ovpn_iptables
echo '@reboot root /root/sbin/cld_ovpn_iptables' > /etc/cron.d/ovpn_iptables

iptables-save | grep -v "cldovpn" | iptables-restore ; source <(cat /etc/openvpn/server/iptables_*.rules)

grep "net.ipv4.ip_forward = 1" /etc/sysctl.conf || echo "net.ipv4.ip_forward = 1" >> /etc/sysctl.conf
sysctl -w net.ipv4.ip_forward=1
modprobe tun
sed -i 's/SELINUX=enforcing/SELINUX=disabled/g' /etc/selinux/config
setenforce 0

systemctl stop firewalld
systemctl disable firewalld

systemctl stop firewalld
systemctl disable firewalld
systemctl -f enable openvpn-server@server_${VPN_ID}.service
systemctl start openvpn-server@server_${VPN_ID}.service
systemctl restart openvpn-server@server_${VPN_ID}.service

export SERVERIP=$(wget -qO- ip.cldcloud.com)
mkdir /var/cld/tmp/ovpn/user-configs/ -p
cd /var/cld/tmp/ovpn/user-configs/
mkdir /var/cld/tmp/ovpn/user-configs/files/

cat > /var/cld/tmp/ovpn/user-configs/base.conf << EOL
client
dev tun
proto udp

sndbuf 262144
rcvbuf 262144

dhcp-option DNS 1.1.1.1
redirect-gateway def1

remote $VPN_IP ${PORT}
resolv-retry infinite
nobind
# user nobody
# group nobody
persist-key
persist-tun
remote-cert-tls server
cipher AES-256-GCM
# auth SHA256
auth-nocache
# key-direction 1
# comp-lzo
verb 3
mute 20
explicit-exit-notify
$(cat /var/cld/access/data/vpn/client.d/main.conf 2>/dev/null; cat /var/cld/access/data/vpn/client.d/${USERID}.conf 2>/dev/null)
EOL

cat > /var/cld/tmp/ovpn/user-configs/files/id_${VPN_ID}.ovpn << EOOVPNKEY
$(cat /var/cld/tmp/ovpn/user-configs/base.conf)
<ca>
$(cat /etc/openvpn/easy-rsa/keys/ca.crt)
</ca>
<cert>
$(cat /etc/openvpn/easy-rsa/keys/id_${VPN_ID}.crt)
</cert>
<key>
$(cat /etc/openvpn/easy-rsa/keys/id_${VPN_ID}.key)
</key>
<tls-crypt-v2>
$(cat /etc/openvpn/easy-rsa/keys/tcv2_${VPN_ID}.key)
</tls-crypt-v2>
EOOVPNKEY

cp /var/cld/tmp/ovpn/user-configs/files/id_${VPN_ID}.ovpn /var/cld/modules/access/data/ovpn/${CLD_DOMAIN}_${VPN_ID}.ovpn

cat > /etc/openvpn/ovpnipinit << 'EOL'
#!/bin/bash
USER_SET=$1
USER_NAMESET=$(cut -d - -f 1 <<< ${USER_SET})
USER_CLD_NAME=$(cut -d '@' -f 1 <<< ${USER_NAMESET})
USER_BOT_NAME=$(cut -d '@' -f 2 <<< ${USER_NAMESET})
USER_ID=$(cut -d - -f 2- <<< ${USER_SET})
USER_IP=$(journalctl -eu openvpn-server@server_${USER_SET}.service | grep "Peer Connection Initiated with" | tail -1 | cut -d ']' -f 4 | cut -d : -f 1)

sudo -u ${USER_CLD_NAME} FROM=BOT sudo /var/cld/modules/access/bin/cld-myipbot ${USER_ID} ${USER_BOT_NAME} ${USER_IP}
EOL
chmod 700 /etc/openvpn/ovpnipinit

} 1>&2

[ -f "/var/cld/modules/access/data/ovpn/${CLD_DOMAIN}_${VPN_ID}.ovpn" ] && echo "/var/cld/modules/access/data/ovpn/${CLD_DOMAIN}_${VPN_ID}.ovpn" || echo 404

}